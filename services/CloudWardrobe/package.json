{
  "name": "cloud-wardrobe-api",
  "version": "0.1.0",
  "private": true,
  "description": "CloudWardrobe backend — NestJS + Prisma + PostgreSQL",
  "scripts": {
    "try-on": "tsx --env-file-if-exists=.env src/try-on.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "postinstall": "prisma generate"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.9.0"
  },
  "devDependencies": {
    "prisma": "^6.9.0",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  }
}
